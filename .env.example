# Telegram Bot Configuration
TG_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# Social Media Authentication (optional, for better download success)
# Instagram credentials
INSTAGRAM_USERNAME="your_instagram_username"
INSTAGRAM_PASSWORD="your_instagram_password"

# TikTok credentials
TIKTOK_USERNAME="your_tiktok_username"
TIKTOK_PASSWORD="your_tiktok_password"

# Twitter/X credentials
TWITTER_USERNAME="your_twitter_username"
TWITTER_PASSWORD="your_twitter_password"

# 9GAG credentials (DEPRECATED - use cookies instead)
# Note: Username/password authentication is not supported by yt-dlp for 9GAG
# Use 9gag_cookies.txt file for authentication instead
NINEGAG_USERNAME="your_9gag_username"
NINEGAG_PASSWORD="your_9gag_password"

# Cookies-based authentication (recommended for YouTube and 9GAG)
# YouTube authentication (cookies only - no username/password support)
# To bypass bot detection, export cookies from browser:
# 1. Install browser extension: "Get cookies.txt LOCALLY" 
# 2. Visit youtube.com while logged in
# 3. Export cookies and save as youtube_cookies.txt in bot directory

# 9GAG authentication (cookies only - username/password not supported)
# Required for OAuth/Google login users:
# 1. Install browser extension: "Get cookies.txt LOCALLY"
# 2. Visit 9gag.com while logged in
# 3. Export cookies and save as 9gag_cookies.txt in bot directory

# Proxy configuration (optional, for bypassing blocks)
# Single proxy (legacy support)
YTDLP_PROXY=""

# Multiple proxies with automatic fallback (comma-separated)
# The bot will try each proxy in order, then try without proxy as last resort
# Free proxy examples (may not always work, replace with reliable ones):
# SOCKS5: socks5://proxy.example.com:1080
# HTTP: http://proxy.example.com:8080
# HTTPS: https://proxy.example.com:8443
YTDLP_PROXIES=""

# Working proxy examples (you need to find active proxies):
# YTDLP_PROXIES="socks5://PROXY_HOST:PORT,http://PROXY_HOST:PORT,socks5://user:pass@proxy.provider.com:1080"
# Free proxy lists to find working ones:
# - https://www.proxy-list.download/
# - https://github.com/hookzof/socks5_list
# - https://github.com/TheSpeedX/PROXY-List
# - https://spys.one/en/socks-proxy-list/
# - https://www.socks-proxy.net/