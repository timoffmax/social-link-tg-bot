# Telegram Bot Configuration
TG_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# Admin configuration
# Your Telegram user ID for admin-only commands (/adminstats)
# Get your ID by messaging @userinfobot on Telegram
ADMIN_USER_ID=""

# Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="social_link_bot"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_SSLMODE="disable"

# Media tracking configuration
DEFAULT_DAILY_MEDIA_LIMIT="0"  # 0 means no limit

# Proxy configuration (optional, for bypassing regional blocks)
# Unified proxy list for all platforms except YouTube (comma-separated)
# Every platform tries a direct connection first, then the proxies (when
# enabled for it). YouTube has proxies off unless ENABLE_YOUTUBE_PROXY="true"
# Supported formats: socks5://host:port, http://host:port, https://host:port
# With authentication: socks5://user:pass@host:port
YTDLP_PROXIES=""

# Example configuration:
# YTDLP_PROXIES="socks5://proxy1.example.com:1080,http://proxy2.example.com:8080,socks5://user:pass@proxy3.example.com:1080"

# Global proxy control
# Set to "false" to disable proxies for ALL platforms
ENABLE_PROXIES="true"

# Per-platform proxy control
# These settings only apply when ENABLE_PROXIES="true"
# Set to "false" to disable proxies for specific platforms
ENABLE_YOUTUBE_PROXY="false"    # YouTube: direct connection only by default
ENABLE_TWITTER_PROXY="true"     # Twitter/X proxy usage
ENABLE_TIKTOK_PROXY="true"      # TikTok proxy usage
ENABLE_FACEBOOK_PROXY="true"    # Facebook proxy usage
ENABLE_REDDIT_PROXY="true"      # Reddit proxy usage
ENABLE_9GAG_PROXY="true"        # 9GAG proxy usage

# Proxy usage notes:
# - Proxies are a FALLBACK, not the primary path: platforms first try direct
#   extraction chains (Instagram kkinstagram→OG preview, Reddit
#   vxreddit→reddit-api, etc.) and only use proxies when ENABLE_PROXIES="true"
# - Direct connection first everywhere; YouTube adds proxies only with ENABLE_YOUTUBE_PROXY="true"

# Rate limiting configuration
YOUTUBE_DELAY="5"

# Platform enablement (true/false) - control which services are active
# Set to "false" to disable a platform entirely
ENABLE_YOUTUBE="true"
ENABLE_TWITTER="true"
ENABLE_TIKTOK="true"
ENABLE_INSTAGRAM="true"
ENABLE_FACEBOOK="true"
ENABLE_REDDIT="true"
ENABLE_9GAG="true"
ENABLE_THREADS="true"

# Instagram service configuration
# Proxy service domain used for Telegram preview links (when direct media
# extraction fails). Dead aliases (kksave, kkinstagram, instagramez,
# ddinstagram) are silently migrated to the default.
# Options: "toinstagram" (default), "onebigram"
INSTAGRAM_SERVICE="toinstagram"

# Instagram extraction chain (reels/posts): tried in order, sequentially.
# 1) kkinstagram redirector (free, no key)
# 2) OG-thumbnail preview fallback (built-in)
KKINSTAGRAM_HOST="kkinstagram.com"

# Paid fetch of Instagram posts gated by their author (e.g. "People under 15
# can't see this content"). Runs only after the free chain fails on such a
# post; media is sent blurred (spoiler). Needs the PostgreSQL database for
# quotas (fails closed without it). Leave APIFY_TOKEN empty to disable.
# Every chat gets a monthly quota (groups: per chat; private chats: per user);
# the owner can stop a group with /gated off or change limits with /gated.
# The bot only explains the restriction once a quota is used up. 0 = none.
APIFY_TOKEN=""
APIFY_INSTAGRAM_ACTOR="intropix~instagram-posts-reels-scraper"
GATED_FETCH_GLOBAL_MONTHLY_CAP="100"
GATED_FETCH_USER_MONTHLY_ALLOWANCE="20"
GATED_FETCH_CHAT_MONTHLY_CAP="20"

# All Apify use (gated Instagram posts, Instagram stories, YouTube) shares one
# monthly budget: before each run the bot reads the account's real usage and
# refuses a run that could exceed it (the free plan has $5 of credit).
APIFY_MONTHLY_BUDGET_USD="4"

# Optional "support the developer" payments in Telegram Stars (25/50/100 Stars
# tier buttons on /donate, alias /support, plus /paysupport and /terms). Each
# payment adds +10, +25 or +60 bonus downloads of restricted Instagram posts,
# used after the monthly free ones run out. Needs the PostgreSQL database. Off
# by default: /donate then shows only the crypto options and payments are
# refused. Bonus downloads already paid for keep working while it's off.
STARS_SUPPORT_ENABLED="false"
# Only YouTube Shorts and community posts are handled (regular videos are
# ignored). YouTube walls datacenter IPs, so after yt-dlp fails a Short is
# downloaded through this actor (480p, 360p if too large; ~$0.015/minute).
APIFY_YOUTUBE_ACTOR="marielise.dev~youtube-video-downloader"
# Instagram stories need a login; this actor fetches the account's story tray.
APIFY_STORIES_ACTOR="goat255~instagram-stories-highlights-scraper"

# TikTok kk-style redirector (same operator as kkinstagram), used as a video
# fallback method after tikwm.com in the custom TikTok extraction chain.
KKTIKTOK_HOST="kktiktok.com"

# Reddit frontend that re-serves video (audio merged) from its own CDN, used
# as a datacenter-robust fallback after the direct JSON extractor.
VXREDDIT_HOST="vxreddit.com"
