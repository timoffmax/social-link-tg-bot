# Telegram Bot Configuration
TG_BOT_TOKEN="YOUR_BOT_TOKEN_FROM_BOTFATHER"

# Admin configuration
# Your Telegram user ID for admin-only commands (/adminstats)
# Get your ID by messaging @userinfobot on Telegram
ADMIN_USER_ID=""

# Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="social_link_bot"
DB_USER="postgres"
DB_PASSWORD="your_password"
DB_SSLMODE="disable"

# Media tracking configuration
DEFAULT_DAILY_MEDIA_LIMIT="0"  # 0 means no limit

# Cookie-based authentication (recommended for all platforms)
# Use VNC for server-IP authenticated cookie extraction:
# 1. Start VNC: ./bin/quick-vnc-setup
# 2. Connect via SSH tunnel: ssh -L 5901:localhost:5901 user@server
# 3. Open Firefox in VNC, login to desired platform
# 4. Extract cookies: ./bin/extract-firefox-cookies
#
# Supported cookie files (place in bot directory):
# - youtube_cookies.txt (YouTube authentication)
# - twitter_cookies.txt (Twitter/X authentication)
# - tiktok_cookies.txt (TikTok authentication)
# - instagram_cookies.txt (Instagram authentication)
# - facebook_cookies.txt (Facebook authentication)
# - reddit_cookies.txt (Reddit authentication)
# - 9gag_cookies.txt (9GAG authentication)

# Proxy configuration (optional, for bypassing regional blocks)
# Unified proxy list for all platforms except YouTube (comma-separated)
# YouTube uses direct connection with server-IP authenticated cookies
# Supported formats: socks5://host:port, http://host:port, https://host:port
# With authentication: socks5://user:pass@host:port
YTDLP_PROXIES=""

# Example configuration:
# YTDLP_PROXIES="socks5://proxy1.example.com:1080,http://proxy2.example.com:8080,socks5://user:pass@proxy3.example.com:1080"

# Global proxy control
# Set to "false" to disable proxies for ALL platforms
ENABLE_PROXIES="true"

# Per-platform proxy control
# These settings only apply when ENABLE_PROXIES="true"
# Set to "false" to disable proxies for specific platforms
ENABLE_YOUTUBE_PROXY="false"    # YouTube always uses direct connection
ENABLE_TWITTER_PROXY="true"     # Twitter/X proxy usage
ENABLE_TIKTOK_PROXY="true"      # TikTok proxy usage
ENABLE_INSTAGRAM_PROXY="true"   # Instagram proxy usage
ENABLE_FACEBOOK_PROXY="true"    # Facebook proxy usage
ENABLE_REDDIT_PROXY="true"      # Reddit proxy usage
ENABLE_9GAG_PROXY="true"        # 9GAG proxy usage

# Proxy usage notes:
# - Proxies are a FALLBACK, not the primary path: platforms first try direct
#   extraction chains (Instagram FastSaver→kkinstagram→cobalt, Reddit
#   reddit-api→vxreddit, etc.) and only use proxies when ENABLE_PROXIES="true"
# - YouTube always uses a direct connection (no proxies)

# Rate limiting configuration
YOUTUBE_DELAY="5"

# Platform enablement (true/false) - control which services are active
# Set to "false" to disable a platform entirely
ENABLE_YOUTUBE="true"
ENABLE_TWITTER="true"
ENABLE_TIKTOK="true"
ENABLE_INSTAGRAM="true"
ENABLE_FACEBOOK="true"
ENABLE_REDDIT="true"
ENABLE_9GAG="true"

# Cookie usage control (optional)
# Set to "false" to disable cookie authentication for specific platforms
# Useful when cookies are invalid, accounts are suspended, or for testing
ENABLE_YOUTUBE_COOKIES="true"
ENABLE_TWITTER_COOKIES="true"
ENABLE_TIKTOK_COOKIES="true"
ENABLE_INSTAGRAM_COOKIES="false"  # Default to false for Instagram
ENABLE_FACEBOOK_COOKIES="true"
ENABLE_REDDIT_COOKIES="true"
ENABLE_9GAG_COOKIES="true"

# Instagram service configuration
# Proxy service domain used for Telegram preview links (when direct media
# extraction fails). Dead aliases (kksave, kkinstagram, instagramez,
# ddinstagram) are silently migrated to the default.
# Options: "toinstagram" (default), "onebigram"
INSTAGRAM_SERVICE="toinstagram"

# RapidAPI configuration (legacy, optional — for Instagram Stories)
# Only used if set; the main Instagram chain below works without it
RAPIDAPI_KEY=""
RAPIDAPI_INSTAGRAM_HOST="instagram120.p.rapidapi.com"

# Instagram extraction chain (reels/posts): tried in order, sequentially.
# 1) FastSaverAPI (keyed primary, only used when FASTSAVER_API_KEY is set)
# 2) kkinstagram redirector (free, no key)
# 3) cobalt.tools public instance(s) (free, no key, handles carousels)
# 4) OG-thumbnail preview fallback (built-in)
FASTSAVER_API_KEY=""
FASTSAVER_API_HOST="api.fastsaver.io"
KKINSTAGRAM_HOST="kkinstagram.com"
COBALT_INSTANCES="https://co.eepy.today"

# TikTok kk-style redirector (same operator as kkinstagram), used as a video
# fallback method after tikwm.com in the custom TikTok extraction chain.
KKTIKTOK_HOST="kktiktok.com"

# Reddit frontend that re-serves video (audio merged) from its own CDN, used
# as a datacenter-robust fallback after the direct JSON extractor.
VXREDDIT_HOST="vxreddit.com"

# Platform credentials (optional, used as fallback if cookies not available/disabled)
INSTAGRAM_USERNAME=""
INSTAGRAM_PASSWORD=""
TWITTER_USERNAME=""
TWITTER_PASSWORD=""
TIKTOK_USERNAME=""
TIKTOK_PASSWORD=""
