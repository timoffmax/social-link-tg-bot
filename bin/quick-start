#!/bin/bash

# quick-start - Start bot as current user for testing
# ==================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/deploy.conf"

# Load configuration
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    echo "Error: Configuration file not found: $CONFIG_FILE"
    exit 1
fi

echo "🚀 Quick start for Social Link Bot as current user..."

# SSH and start
ssh "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && pkill -f social-link-bot; sleep 2; mkdir -p logs && export PATH='$REMOTE_DIR/bin:\$PATH' && (./$REMOTE_BIN_NAME --name=$REMOTE_BIN_NAME > logs/bot.log 2>&1 &)"

sleep 2

# Check if it started
echo "Checking if bot started..."
ssh "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && ps aux | grep social-link-bot | grep -v grep"

echo ""
echo "✅ Quick start completed!"
echo ""
echo "📊 To check logs:"
echo "  ssh $SERVER_USER@$SERVER_IP 'tail -f $REMOTE_DIR/logs/bot.log'"
echo ""
echo "📱 To test Instagram download:"
echo "  Send an Instagram link to the bot and check logs for yt-dlp detection"