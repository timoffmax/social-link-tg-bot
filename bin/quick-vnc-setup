#!/bin/bash

# Quick VNC setup for YouTube authentication from server IP
# Fastest way to get a browser running on the server

echo "🚀 Quick VNC Setup for Server-IP Authentication"
echo "==============================================="
echo ""
echo "📍 Server IP: $(curl -s ifconfig.me 2>/dev/null || echo "Unknown")"
echo ""

# Check if already running
if pgrep -f "Xtightvnc.*:1" > /dev/null; then
    echo "✅ VNC server already running on display :1"
    echo ""
    echo "🌐 Connection info:"
    echo "   VNC Address: $(curl -s ifconfig.me):5901"
    echo "   SSH Tunnel:  ssh -L 5901:localhost:5901 $USER@$(curl -s ifconfig.me)"
    echo "   Local VNC:   localhost:5901"
    echo ""
    echo "🔄 Manage VNC:"
    echo "   Stop: vncserver -kill :1"
    echo "   Restart: vncserver -kill :1 && vncserver :1"
    exit 0
fi

echo "📦 Installing VNC and browser..."

# Install essential packages
sudo apt update
sudo apt install -y tightvncserver xfce4 xfce4-terminal firefox-esr

echo "🔧 Configuring VNC..."

# Create VNC directory
mkdir -p ~/.vnc

# Create xstartup script
cat > ~/.vnc/xstartup << 'EOF'
#!/bin/bash
xrdb $HOME/.Xresources
xsetroot -solid grey
xfce4-panel &
xfce4-terminal &
firefox &
xfwm4 &
EOF

chmod +x ~/.vnc/xstartup

echo ""
echo "🔑 Setting VNC password..."
echo "Choose a secure password for VNC access:"
vncpasswd

echo ""
echo "🚀 Starting VNC server..."
vncserver :1 -geometry 1280x800 -depth 24

if pgrep -f "Xtightvnc.*:1" > /dev/null; then
    echo ""
    echo "✅ VNC Server started successfully!"
    echo ""
    echo "🌐 Connection Options:"
    echo ""
    echo "Option 1 - Direct connection:"
    echo "  Address: $(curl -s ifconfig.me):5901"
    echo "  (May require firewall configuration)"
    echo ""
    echo "Option 2 - SSH Tunnel (recommended):"
    echo "  Local machine: ssh -L 5901:localhost:5901 $USER@$(curl -s ifconfig.me)"
    echo "  VNC client: localhost:5901"
    echo ""
    echo "🖥️ VNC Clients:"
    echo "  Windows: TightVNC, RealVNC, UltraVNC"
    echo "  Mac: Screen Sharing, RealVNC"
    echo "  Linux: vncviewer, Remmina"
    echo ""
    echo "📱 After connecting:"
    echo "  1. Firefox should auto-start"
    echo "  2. Go to https://www.youtube.com"
    echo "  3. Log in with your Google account"
    echo "  4. Install 'Get cookies.txt LOCALLY' extension"
    echo "  5. Export cookies and save as youtube_cookies.txt"
    echo ""
    echo "📁 Cookie file location: /var/www/social-link-tg-bot/youtube_cookies.txt"
    echo ""
    echo "🔄 VNC Management:"
    echo "  Stop:    vncserver -kill :1"
    echo "  Restart: vncserver -kill :1 && vncserver :1"
    echo "  Status:  vncserver -list"
else
    echo "❌ Failed to start VNC server"
    echo ""
    echo "🔧 Troubleshooting:"
    echo "  Check logs: cat ~/.vnc/*.log"
    echo "  Manual start: vncserver :1 -geometry 1280x800"
    exit 1
fi