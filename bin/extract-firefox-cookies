#!/bin/bash

# Extract cookies from Firefox running on the server
# Uses server-IP authenticated session for any social media platform
# Usage: ./bin/extract-firefox-cookies [platform]
# Supported: youtube, twitter, tiktok, instagram, facebook, reddit, 9gag, all

# Parse command line arguments
PLATFORM="${1:-all}"

case "$PLATFORM" in
    youtube|twitter|tiktok|instagram|facebook|reddit|9gag|all)
        ;; # Valid platform
    *)
        echo "❌ Invalid platform: $PLATFORM"
        echo "📖 Usage: $0 [platform]"
        echo "📋 Supported platforms: youtube, twitter, tiktok, instagram, facebook, reddit, 9gag, all"
        echo "💡 Default: all (extracts cookies for all platforms)"
        exit 1
        ;;
esac

if [ "$PLATFORM" = "all" ]; then
    echo "🦊 Extracting Cookies from Firefox (All Platforms)"
    echo "=================================================="
else
    echo "🦊 Extracting ${PLATFORM^} Cookies from Firefox"
    echo "==========================================="
fi
echo ""

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="$(dirname "$SCRIPT_DIR")"

# Check if Firefox is installed
if ! command -v firefox &> /dev/null; then
    echo "❌ Firefox not found. Install with: sudo apt install firefox-esr"
    exit 1
fi

# Try to find Firefox profile directory (check snap locations too)
FIREFOX_PROFILES=""
for profile_root in ~/snap/firefox/common/.mozilla/firefox ~/.mozilla/firefox ~/.mozilla/firefox-esr; do
    if [ -d "$profile_root" ]; then
        FIREFOX_PROFILES="$profile_root"
        break
    fi
done

if [ -z "$FIREFOX_PROFILES" ]; then
    echo "❌ Firefox profile directory not found"
    echo "💡 Start Firefox first to create a profile, then run this script"
    exit 1
fi

echo "🔍 Found Firefox profiles in: $FIREFOX_PROFILES"

# Find the default profile or most recently used
PROFILE_DIR=""
if [ -f "$FIREFOX_PROFILES/profiles.ini" ]; then
    # Try to find default profile
    DEFAULT_PROFILE=$(grep -A2 "\[Profile0\]" "$FIREFOX_PROFILES/profiles.ini" | grep "Path=" | cut -d'=' -f2)
    if [ -n "$DEFAULT_PROFILE" ]; then
        PROFILE_DIR="$FIREFOX_PROFILES/$DEFAULT_PROFILE"
    fi
fi

# If no default found, use the most recent profile
if [ -z "$PROFILE_DIR" ] || [ ! -d "$PROFILE_DIR" ]; then
    PROFILE_DIR=$(find "$FIREFOX_PROFILES" -maxdepth 1 -type d -name "*.default*" | head -1)
fi

if [ -z "$PROFILE_DIR" ] || [ ! -d "$PROFILE_DIR" ]; then
    echo "❌ Could not find Firefox profile directory"
    echo "Available profiles:"
    ls -la "$FIREFOX_PROFILES/"
    exit 1
fi

echo "📁 Using Firefox profile: $PROFILE_DIR"

# Check if cookies database exists
COOKIES_DB="$PROFILE_DIR/cookies.sqlite"
if [ ! -f "$COOKIES_DB" ]; then
    echo "❌ Firefox cookies database not found: $COOKIES_DB"
    echo "💡 Make sure Firefox has been started and you've visited websites"
    exit 1
fi

echo "🍪 Found cookies database: $COOKIES_DB"

# Check if sqlite3 is available
if ! command -v sqlite3 &> /dev/null; then
    echo "📦 Installing sqlite3..."
    sudo apt update && sudo apt install -y sqlite3
fi

# Extract YouTube cookies from Firefox database
echo "🔄 Extracting YouTube cookies..."

# Create temporary file for extraction
TEMP_COOKIES=$(mktemp)

# Define platform-specific queries
get_platform_query() {
    local platform="$1"
    case "$platform" in
        youtube)
            echo "WHERE host LIKE '%youtube.com%' OR host LIKE '%google.com%'"
            ;;
        twitter)
            echo "WHERE host LIKE '%twitter.com%' OR host LIKE '%x.com%'"
            ;;
        tiktok)
            echo "WHERE host LIKE '%tiktok.com%'"
            ;;
        instagram)
            echo "WHERE host LIKE '%instagram.com%' OR host LIKE '%facebook.com%'"
            ;;
        facebook)
            echo "WHERE host LIKE '%facebook.com%' OR host LIKE '%meta.com%'"
            ;;
        reddit)
            echo "WHERE host LIKE '%reddit.com%'"
            ;;
        9gag)
            echo "WHERE host LIKE '%9gag.com%'"
            ;;
        all)
            echo "WHERE host LIKE '%youtube.com%' OR host LIKE '%google.com%' OR host LIKE '%twitter.com%' OR host LIKE '%x.com%' OR host LIKE '%tiktok.com%' OR host LIKE '%instagram.com%' OR host LIKE '%facebook.com%' OR host LIKE '%meta.com%' OR host LIKE '%reddit.com%' OR host LIKE '%9gag.com%'"
            ;;
    esac
}

# SQL query to extract cookies in Netscape format
WHERE_CLAUSE=$(get_platform_query "$PLATFORM")
sqlite3 -separator $'\t' "$COOKIES_DB" "
SELECT 
    host, 
    CASE 
        WHEN host LIKE '.%' THEN 'TRUE' 
        ELSE 'FALSE' 
    END as domain_flag,
    path,
    CASE 
        WHEN isSecure = 1 THEN 'TRUE' 
        ELSE 'FALSE' 
    END as secure,
    expiry,
    name,
    value
FROM moz_cookies 
$WHERE_CLAUSE
ORDER BY host, name;
" > "$TEMP_COOKIES"

# Check if we got any cookies
if [ ! -s "$TEMP_COOKIES" ]; then
    if [ "$PLATFORM" = "all" ]; then
        echo "❌ No social media cookies found in Firefox"
        echo "💡 Make sure you've logged into social media platforms in Firefox"
    else
        echo "❌ No ${PLATFORM^} cookies found in Firefox"
        echo "💡 Make sure you've logged into ${PLATFORM^} in Firefox"
    fi
    rm "$TEMP_COOKIES"
    exit 1
fi

# Extract cookies by platform
echo "📝 Creating Netscape format cookie files..."

if [ "$PLATFORM" = "all" ]; then
    # Extract for all platforms
    platforms=("youtube" "twitter" "tiktok" "instagram" "facebook" "reddit" "9gag")
    
    for p in "${platforms[@]}"; do
        PLATFORM_TEMP=$(mktemp)
        WHERE_CLAUSE=$(get_platform_query "$p")
        
        sqlite3 -separator $'\t' "$COOKIES_DB" "
        SELECT 
            host, 
            CASE 
                WHEN host LIKE '.%' THEN 'TRUE' 
                ELSE 'FALSE' 
            END as domain_flag,
            path,
            CASE 
                WHEN isSecure = 1 THEN 'TRUE' 
                ELSE 'FALSE' 
            END as secure,
            expiry,
            name,
            value
        FROM moz_cookies 
        $WHERE_CLAUSE
        ORDER BY host, name;
        " > "$PLATFORM_TEMP"
        
        if [ -s "$PLATFORM_TEMP" ]; then
            cat > "$BOT_DIR/${p}_cookies.txt" << EOF
# Netscape HTTP Cookie File
# ${p^} cookies extracted from Firefox on server - authenticated from server IP
EOF
            cat "$PLATFORM_TEMP" >> "$BOT_DIR/${p}_cookies.txt"
            COOKIE_COUNT=$(grep -v '^#' "$BOT_DIR/${p}_cookies.txt" | wc -l)
            echo "✅ ${p^}: $COOKIE_COUNT cookies extracted to ${p}_cookies.txt"
        else
            echo "⚠️ ${p^}: No cookies found (not logged in?)"
        fi
        
        rm "$PLATFORM_TEMP"
    done
else
    # Extract for specific platform
    cat > "$BOT_DIR/${PLATFORM}_cookies.txt" << EOF
# Netscape HTTP Cookie File
# ${PLATFORM^} cookies extracted from Firefox on server - authenticated from server IP
EOF
    cat "$TEMP_COOKIES" >> "$BOT_DIR/${PLATFORM}_cookies.txt"
    echo "✅ ${PLATFORM^} cookies extracted to: $BOT_DIR/${PLATFORM}_cookies.txt"
fi

# Clean up
rm "$TEMP_COOKIES"

# Show total cookie count
if [ "$PLATFORM" != "all" ]; then
    COOKIE_COUNT=$(grep -v '^#' "$BOT_DIR/${PLATFORM}_cookies.txt" | wc -l)
    echo "📊 Extracted $COOKIE_COUNT cookies"
fi

# Test the cookies
if [ "$PLATFORM" = "youtube" ] || [ "$PLATFORM" = "all" ]; then
    if [ -f "$BOT_DIR/youtube_cookies.txt" ] && [ -s "$BOT_DIR/youtube_cookies.txt" ]; then
        echo "🧪 Testing YouTube cookies..."
        if yt-dlp --cookies "$BOT_DIR/youtube_cookies.txt" --dump-json --no-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ" >/dev/null 2>&1; then
            echo "✅ YouTube cookies are working!"
        else
            echo "⚠️ YouTube cookie test failed"
        fi
    fi
fi

echo ""
if [ "$PLATFORM" = "all" ]; then
    echo "🎉 Server-IP authenticated cookies ready for use!"
    echo "🤖 The bot will now use these cookies for enhanced platform access"
else
    echo "🎉 Server-IP authenticated ${PLATFORM^} cookies ready for use!"
    echo "🤖 The bot will now use these cookies for ${PLATFORM^} downloads"
fi
echo ""
echo "🔄 To refresh cookies:"
echo "   1. Open Firefox in VNC and navigate to platform(s)"
echo "   2. Log out and log back in"
echo "   3. Run this script again: ./bin/extract-firefox-cookies [platform]"
echo ""
echo "📋 Available platforms: youtube, twitter, tiktok, instagram, facebook, reddit, 9gag, all"