#!/bin/bash

# Install Chrome/Chromium on production server for TikTok slideshow extraction

echo "🔍 Installing Chrome/Chromium for TikTok slideshow support..."

# Check if running as root/sudo
if [ "$EUID" -ne 0 ]; then
    echo "❌ This script needs to be run with sudo privileges"
    echo "Please run: sudo ./bin/install-chrome"
    exit 1
fi

# Update package lists
echo "📦 Updating package lists..."
apt update

# Try to install Google Chrome first
echo "🌐 Attempting to install Google Chrome..."
if ! command -v wget &> /dev/null; then
    apt install -y wget
fi

# Add Google Chrome repository
wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | apt-key add -
echo "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main" > /etc/apt/sources.list.d/google-chrome.list

apt update

# Install Google Chrome
if apt install -y google-chrome-stable; then
    echo "✅ Google Chrome installed successfully!"
    echo "📍 Chrome location: $(which google-chrome-stable)"
else
    echo "⚠️ Google Chrome installation failed, trying Chromium..."
    
    # Fallback to Chromium
    if apt install -y chromium chromium-driver; then
        echo "✅ Chromium installed successfully!"
        echo "📍 Chromium location: $(which chromium)"
    else
        echo "❌ Both Chrome and Chromium installation failed"
        echo "🔍 Please install manually or check system compatibility"
        exit 1
    fi
fi

# Verify installation
echo "🔍 Verifying installation..."
if command -v google-chrome-stable &> /dev/null; then
    echo "✅ Google Chrome found: $(which google-chrome-stable)"
    google-chrome-stable --version
elif command -v google-chrome &> /dev/null; then
    echo "✅ Google Chrome found: $(which google-chrome)"
    google-chrome --version
elif command -v chromium &> /dev/null; then
    echo "✅ Chromium found: $(which chromium)"
    chromium --version
elif command -v chromium-browser &> /dev/null; then
    echo "✅ Chromium found: $(which chromium-browser)"
    chromium-browser --version
else
    echo "❌ No Chrome/Chromium found after installation"
    exit 1
fi

echo ""
echo "🎉 Chrome/Chromium installation complete!"
echo "🚀 The TikTok slideshow extraction feature should now work properly"
echo "📋 You can test by restarting the bot: sudo systemctl restart social-link-bot"