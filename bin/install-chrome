#!/bin/bash

# Install Chrome/Chromium on production server for TikTok slideshow extraction
# This script works without sudo privileges by using portable Chrome

echo "🔍 Installing Chrome for TikTok slideshow support (user-space installation)..."

# Set installation directory in user's home directory
CHROME_DIR="$HOME/chrome"
CHROME_BINARY="$CHROME_DIR/chrome"

# Check if Chrome is already installed in user space
if [ -f "$CHROME_BINARY" ]; then
    echo "✅ Chrome already installed at $CHROME_BINARY"
    echo "📍 Chrome version: $($CHROME_BINARY --version 2>/dev/null || echo 'Unknown')"
    exit 0
fi

# Create Chrome directory
mkdir -p "$CHROME_DIR"
cd "$CHROME_DIR"

echo "📦 Downloading portable Chrome..."

# Download Chrome for Linux (portable version)
CHROME_URL="https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb"
DEB_FILE="google-chrome-stable.deb"

if command -v wget &> /dev/null; then
    wget -O "$DEB_FILE" "$CHROME_URL"
elif command -v curl &> /dev/null; then
    curl -L -o "$DEB_FILE" "$CHROME_URL"
else
    echo "❌ Neither wget nor curl found. Cannot download Chrome."
    echo "Please install wget or curl first."
    exit 1
fi

# Check if download was successful
if [ ! -f "$DEB_FILE" ] || [ ! -s "$DEB_FILE" ]; then
    echo "❌ Failed to download Chrome package"
    exit 1
fi

# Extract Chrome from .deb package without installing system-wide
echo "📂 Extracting Chrome package..."
if command -v dpkg-deb &> /dev/null; then
    dpkg-deb -x "$DEB_FILE" extracted/
elif command -v ar &> /dev/null; then
    # Alternative extraction method using ar
    ar x "$DEB_FILE"
    if [ -f "data.tar.xz" ]; then
        tar -xf data.tar.xz
        mv opt/google/chrome/* .
    elif [ -f "data.tar.gz" ]; then
        tar -xf data.tar.gz  
        mv opt/google/chrome/* .
    else
        echo "❌ Could not find data archive in .deb package"
        exit 1
    fi
else
    echo "❌ Cannot extract .deb package. Neither dpkg-deb nor ar found."
    echo "Trying alternative download method..."
    
    # Fallback: try to get Chromium instead
    rm -f "$DEB_FILE"
    echo "📦 Trying Chromium portable installation..."
    
    # Download Chromium (often more readily available)
    CHROMIUM_URL="https://commondatastorage.googleapis.com/chromium-browser-snapshots/Linux_x64/LAST_CHANGE"
    if command -v wget &> /dev/null; then
        LATEST=$(wget -qO- "$CHROMIUM_URL")
        CHROMIUM_ZIP_URL="https://commondatastorage.googleapis.com/chromium-browser-snapshots/Linux_x64/$LATEST/chrome-linux.zip"
        wget -O chromium.zip "$CHROMIUM_ZIP_URL"
    else
        echo "❌ Cannot download Chromium either. Please install dpkg-deb, ar, or wget."
        exit 1
    fi
    
    if command -v unzip &> /dev/null; then
        unzip -q chromium.zip
        if [ -d "chrome-linux" ]; then
            mv chrome-linux/* .
            CHROME_BINARY="$CHROME_DIR/chrome"
        else
            echo "❌ Failed to extract Chromium"
            exit 1
        fi
    else
        echo "❌ unzip not found. Cannot extract Chromium."
        exit 1
    fi
fi

# If we used dpkg-deb extraction, move Chrome to the right location
if [ -d "extracted/opt/google/chrome" ]; then
    mv extracted/opt/google/chrome/* .
    rm -rf extracted/
    CHROME_BINARY="$CHROME_DIR/chrome"
elif [ -d "extracted/usr/bin" ]; then
    mv extracted/usr/bin/google-chrome-stable chrome
    CHROME_BINARY="$CHROME_DIR/chrome"
fi

# Clean up download files
rm -f "$DEB_FILE" chromium.zip data.tar.* control.tar.*

# Make Chrome executable
chmod +x "$CHROME_BINARY" 2>/dev/null

# Verify installation
echo "🔍 Verifying Chrome installation..."
if [ -f "$CHROME_BINARY" ] && [ -x "$CHROME_BINARY" ]; then
    echo "✅ Chrome installed successfully at $CHROME_BINARY"
    
    # Test Chrome version (suppress errors in case of missing dependencies)
    VERSION=$("$CHROME_BINARY" --version 2>/dev/null || echo "Installed (version check failed)")
    echo "📍 Chrome version: $VERSION"
    
    # Create a symlink in a directory that might be in PATH for easier access
    mkdir -p "$HOME/bin" 2>/dev/null
    ln -sf "$CHROME_BINARY" "$HOME/bin/chrome" 2>/dev/null
    
    echo ""
    echo "🎉 Chrome installation complete!"
    echo "📍 Chrome binary: $CHROME_BINARY"
    echo "🔧 A symlink was created at $HOME/bin/chrome (if $HOME/bin is in your PATH)"
    echo "🚀 The TikTok slideshow extraction feature should now work properly"
    echo "📋 You can test by restarting the bot: systemctl --user restart social-link-bot"
    echo ""
    echo "ℹ️  If the bot still can't find Chrome, make sure the path detection in"
    echo "    tiktok_extractor.go includes: $CHROME_BINARY"
else
    echo "❌ Chrome installation failed"
    echo "🔍 Please check the installation manually or try installing Chrome system-wide"
    exit 1
fi