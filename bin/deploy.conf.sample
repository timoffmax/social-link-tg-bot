# Deploy Configuration for Social Link Telegram Bot
# =================================================
# Copy this file to deploy.conf and update with your values.
# Read by bin/deploy and by `make status` / `make logs`.

# Server Configuration
SERVER_IP="your.server.ip.address"
SERVER_USER="your-username"
SERVER_SSH_KEY="/home/your-local-user/.ssh/your_deploy_key" # Required: bin/deploy passes it to every ssh call

# Git checkout of this repository on the server (bin/deploy runs git pull and go build there)
REMOTE_DIR="/var/www/social-link-tg-bot"

# systemd service restarted by bin/deploy
SERVICE_NAME="social-link-bot"
