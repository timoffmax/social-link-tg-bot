#!/bin/bash

# switch-to-user-deployment - Switch from /var/www to user deployment
# ==================================================================

set -euo pipefail

SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "🔄 Switching to User-Level Deployment"
echo "===================================="
echo ""
echo "This will:"
echo "1. Stop the bot at /var/www/social-link-tg-bot"
echo "2. Disable it from auto-starting"
echo "3. Start your bot at /path/to/social-link-bot"
echo ""
read -p "Continue? (y/N): " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
fi

echo ""
echo -e "${BLUE}[INFO]${NC} Connecting to server..."

ssh ${SERVER_USER}@${SERVER_IP} '
    echo "=== Current Status ==="
    echo "Checking which bots are running..."
    ps aux | grep social-link-bot | grep -v grep || echo "No bots running"
    
    echo ""
    echo "=== Stopping Old Bot ==="
    if sudo systemctl is-active --quiet social-link-bot; then
        echo "Stopping /var/www/social-link-tg-bot..."
        sudo systemctl stop social-link-bot
        echo "Disabling auto-start..."
        sudo systemctl disable social-link-bot
        echo "Old bot stopped and disabled"
    else
        echo "Old bot is not running"
    fi
    
    # Kill any remaining processes
    sudo pkill -f "/var/www/social-link-tg-bot/social-link-bot" 2>/dev/null || true
    
    echo ""
    echo "=== Starting User Bot ==="
    echo "Enabling user-level bot..."
    systemctl --user enable social-link-bot
    
    echo "Starting user-level bot..."
    systemctl --user start social-link-bot
    
    sleep 3
    
    echo ""
    echo "=== Final Status ==="
    if systemctl --user is-active --quiet social-link-bot; then
        echo "✅ User bot is running successfully!"
        systemctl --user status social-link-bot --no-pager | head -10
    else
        echo "❌ User bot failed to start"
        echo "Recent logs:"
        tail -20 /path/to/social-link-bot/logs/bot.log 2>/dev/null || echo "No logs found"
    fi
    
    echo ""
    echo "=== Verification ==="
    ps aux | grep social-link-bot | grep -v grep || echo "No bots running"
'

echo ""
echo -e "${GREEN}[SUCCESS]${NC} Switch completed!"
echo ""
echo "Your bot is now running from: /path/to/social-link-bot"
echo ""
echo "Management commands:"
echo "  ./bin/server status   - Check status"
echo "  ./bin/server logs     - View logs"
echo "  ./bin/server restart  - Restart bot"
echo "  ./bin/deploy          - Deploy updates"