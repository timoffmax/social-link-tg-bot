#!/bin/bash

# server - Server Management Script for Social Link Telegram Bot
# =============================================================
#
# This script provides easy access to server management commands
#
# Usage: 
#   ./bin/server <command> [options]
#
# Commands:
#   ssh           - SSH into the server
#   logs          - View bot logs
#   status        - Check service status
#   restart       - Restart the bot service
#   stop          - Stop the bot service
#   start         - Start the bot service
#   config        - Edit configuration file
#   update-deps   - Update yt-dlp and other dependencies
#   monitor       - Monitor logs in real-time
#   backup        - Backup configuration and logs

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"
REMOTE_PATH="/path/to/social-link-bot"
SERVICE_NAME="social-link-bot"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to run remote commands
run_remote() {
    local cmd="$1"
    ssh "${SERVER_USER}@${SERVER_IP}" "$cmd"
}

# Function to show help
show_help() {
    echo "🤖 Social Link Telegram Bot - Server Management"
    echo "=============================================="
    echo ""
    echo "Usage: $0 <command> [options]"
    echo ""
    echo "Commands:"
    echo "  ssh           - SSH into the server"
    echo "  logs [lines]  - View bot logs (default: 50 lines)"
    echo "  status        - Check service status"
    echo "  restart       - Restart the bot service"
    echo "  stop          - Stop the bot service"
    echo "  start         - Start the bot service"
    echo "  config        - Edit configuration file (.env)"
    echo "  update-deps   - Update yt-dlp and other dependencies"
    echo "  monitor       - Monitor logs in real-time"
    echo "  backup        - Backup configuration and logs"
    echo "  disk          - Check disk usage"
    echo "  processes     - Show bot-related processes"
    echo ""
    echo "Examples:"
    echo "  $0 logs 100      # Show last 100 log lines"
    echo "  $0 restart       # Restart the bot"
    echo "  $0 monitor       # Watch logs in real-time"
    echo ""
}

# Command functions
cmd_ssh() {
    log_info "Connecting to server..."
    ssh "${SERVER_USER}@${SERVER_IP}"
}

cmd_logs() {
    local lines=${1:-50}
    log_info "Showing last $lines lines of logs..."
    run_remote "tail -n $lines ${REMOTE_PATH}/logs/bot.log 2>/dev/null || echo 'No logs found yet'"
}

cmd_status() {
    log_info "Checking service status..."
    run_remote "systemctl --user status $SERVICE_NAME --no-pager -l"
}

cmd_restart() {
    log_info "Restarting bot service..."
    run_remote "systemctl --user restart $SERVICE_NAME"
    sleep 2
    log_success "Service restarted"
    cmd_status
}

cmd_stop() {
    log_info "Stopping bot service..."
    run_remote "systemctl --user stop $SERVICE_NAME"
    log_success "Service stopped"
}

cmd_start() {
    log_info "Starting bot service..."
    run_remote "systemctl --user start $SERVICE_NAME"
    sleep 2
    log_success "Service started"
    cmd_status
}

cmd_config() {
    log_info "Opening configuration file for editing..."
    run_remote "nano ${REMOTE_PATH}/.env"
}

cmd_update_deps() {
    log_info "Updating dependencies on server..."
    
    log_info "Updating yt-dlp..."
    run_remote "pip3 install --upgrade yt-dlp || sudo apt update && sudo apt install -y python3-pip && pip3 install --upgrade yt-dlp"
    
    log_info "Updating system packages..."
    run_remote "sudo apt update && sudo apt upgrade -y"
    
    log_success "Dependencies updated"
    log_warning "Consider restarting the bot to use updated dependencies"
}

cmd_monitor() {
    log_info "Monitoring logs in real-time (Ctrl+C to exit)..."
    echo "Press Ctrl+C to stop monitoring"
    echo "================================"
    run_remote "tail -f ${REMOTE_PATH}/logs/bot.log 2>/dev/null || (echo 'No logs found, creating log file...' && touch ${REMOTE_PATH}/logs/bot.log && tail -f ${REMOTE_PATH}/logs/bot.log)"
}

cmd_backup() {
    local backup_dir="./backups"
    local timestamp=$(date +"%Y%m%d_%H%M%S")
    local backup_file="${backup_dir}/social-link-bot_${timestamp}.tar.gz"
    
    log_info "Creating backup..."
    
    # Create local backup directory
    mkdir -p "$backup_dir"
    
    # Create backup on server and download
    run_remote "cd /tmp && tar -czf social-link-bot_backup_${timestamp}.tar.gz -C ${REMOTE_PATH} .env logs/ 2>/dev/null || echo 'Some files may not exist yet'"
    
    # Download backup
    scp "${SERVER_USER}@${SERVER_IP}:/tmp/social-link-bot_backup_${timestamp}.tar.gz" "$backup_file"
    
    # Clean up remote backup file
    run_remote "rm -f /tmp/social-link-bot_backup_${timestamp}.tar.gz"
    
    log_success "Backup created: $backup_file"
}

cmd_disk() {
    log_info "Checking disk usage..."
    echo ""
    echo "Overall disk usage:"
    run_remote "df -h /"
    echo ""
    echo "Bot directory usage:"
    run_remote "du -sh ${REMOTE_PATH} 2>/dev/null || echo 'Bot directory not found'"
    echo ""
    echo "Log file sizes:"
    run_remote "ls -lh ${REMOTE_PATH}/logs/ 2>/dev/null || echo 'No logs directory found'"
}

cmd_processes() {
    log_info "Checking bot-related processes..."
    echo ""
    echo "Bot processes:"
    run_remote "ps aux | grep -E '(social-link-bot|yt-dlp)' | grep -v grep || echo 'No bot processes found'"
    echo ""
    echo "System load:"
    run_remote "uptime"
    echo ""
    echo "Memory usage:"
    run_remote "free -h"
}

# Main function
main() {
    local command="${1:-help}"
    
    case "$command" in
        ssh)
            cmd_ssh
            ;;
        logs)
            cmd_logs "${2:-50}"
            ;;
        status)
            cmd_status
            ;;
        restart)
            cmd_restart
            ;;
        stop)
            cmd_stop
            ;;
        start)
            cmd_start
            ;;
        config)
            cmd_config
            ;;
        update-deps)
            cmd_update_deps
            ;;
        monitor)
            cmd_monitor
            ;;
        backup)
            cmd_backup
            ;;
        disk)
            cmd_disk
            ;;
        processes)
            cmd_processes
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Run main function with all arguments
main "$@"