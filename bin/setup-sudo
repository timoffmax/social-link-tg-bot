#!/bin/bash

# setup-sudo - Setup passwordless sudo for bot management
# =====================================================

echo "Setting up passwordless sudo for bot management..."

# Create sudoers rule for the admin user to manage service processes
SUDOERS_RULE="ADMIN_USER ALL=(botuser) NOPASSWD: /var/www/social-link-tg-bot/social-link-bot, /bin/pkill, /usr/bin/pkill"

# Check if rule already exists
if sudo grep -q "ADMIN_USER.*botuser.*NOPASSWD" /etc/sudoers; then
    echo "✅ Sudo rule already exists"
else
    echo "Adding sudo rule: $SUDOERS_RULE"
    echo "$SUDOERS_RULE" | sudo tee -a /etc/sudoers
    echo "✅ Sudo rule added"
fi

echo "Testing sudo access..."
if sudo -u tgbot -n echo "test" 2>/dev/null; then
    echo "✅ Sudo access working"
else
    echo "❌ Sudo access not working"
    echo "You may need to run this on the server:"
    echo "  ssh YOUR_USER@YOUR_SERVER_IP"
    echo "  sudo visudo"
    echo "  Add line: ADMIN_USER ALL=(botuser) NOPASSWD: ALL"
fi