#!/bin/bash

# restart-production - Quick restart script for production bot
# ===========================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/deploy.conf"

# Load configuration
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    echo "Error: Configuration file not found: $CONFIG_FILE"
    exit 1
fi

echo "🔄 Restarting Social Link Bot on $SERVER_IP..."

# SSH and restart
ssh "$SERVER_USER@$SERVER_IP" "cd $REMOTE_DIR && ./manage-bot restart"

echo "✅ Restart completed!"