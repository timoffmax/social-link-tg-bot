#!/bin/bash

# Install ChromeDriver for Ubuntu/Debian
# Supports headless browser automation

echo "🌐 Installing ChromeDriver for Ubuntu/Debian..."

# Check if we're on Ubuntu/Debian
if ! command -v apt &> /dev/null; then
    echo "❌ This script is for Ubuntu/Debian systems only"
    exit 1
fi

# Check if Chrome is already installed
if command -v google-chrome &> /dev/null; then
    CHROME_VERSION=$(google-chrome --version | grep -oP '\d+\.\d+\.\d+')
    echo "✅ Google Chrome already installed: $CHROME_VERSION"
elif command -v chromium &> /dev/null; then
    CHROME_VERSION=$(chromium --version | grep -oP '\d+\.\d+\.\d+')
    echo "✅ Chromium already installed: $CHROME_VERSION"
else
    echo "📦 Installing Google Chrome..."
    
    # Add Google's official GPG key
    wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | sudo apt-key add -
    
    # Add Chrome repository
    echo 'deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main' | sudo tee /etc/apt/sources.list.d/google-chrome.list
    
    # Update package list
    sudo apt update
    
    # Install Chrome
    sudo apt install -y google-chrome-stable
    
    if command -v google-chrome &> /dev/null; then
        CHROME_VERSION=$(google-chrome --version | grep -oP '\d+\.\d+\.\d+')
        echo "✅ Google Chrome installed: $CHROME_VERSION"
    else
        echo "❌ Chrome installation failed"
        exit 1
    fi
fi

# Install ChromeDriver
echo "🔧 Installing ChromeDriver..."

# Method 1: Try apt package (Ubuntu 20.04+)
if sudo apt install -y chromium-driver 2>/dev/null; then
    echo "✅ ChromeDriver installed via apt"
elif sudo apt install -y chromedriver 2>/dev/null; then
    echo "✅ ChromeDriver installed via apt"
else
    echo "📦 Installing ChromeDriver manually..."
    
    # Method 2: Manual installation
    # Get the major version of Chrome
    CHROME_MAJOR_VERSION=$(echo $CHROME_VERSION | cut -d. -f1)
    
    # Get the latest ChromeDriver version for this Chrome version
    CHROMEDRIVER_VERSION=$(curl -s "https://chromedriver.storage.googleapis.com/LATEST_RELEASE_$CHROME_MAJOR_VERSION" 2>/dev/null)
    
    if [ -z "$CHROMEDRIVER_VERSION" ]; then
        echo "⚠️ Could not determine ChromeDriver version, trying latest..."
        CHROMEDRIVER_VERSION=$(curl -s https://chromedriver.storage.googleapis.com/LATEST_RELEASE)
    fi
    
    echo "📥 Downloading ChromeDriver $CHROMEDRIVER_VERSION..."
    
    # Download ChromeDriver
    wget -O /tmp/chromedriver.zip "https://chromedriver.storage.googleapis.com/$CHROMEDRIVER_VERSION/chromedriver_linux64.zip"
    
    if [ $? -eq 0 ]; then
        # Extract and install
        cd /tmp
        unzip -o chromedriver.zip
        sudo mv chromedriver /usr/local/bin/
        sudo chmod +x /usr/local/bin/chromedriver
        
        echo "✅ ChromeDriver installed manually to /usr/local/bin/"
        
        # Clean up
        rm -f /tmp/chromedriver.zip /tmp/chromedriver
    else
        echo "❌ Failed to download ChromeDriver"
        exit 1
    fi
fi

# Install Python Selenium
echo "🐍 Installing Python Selenium..."
if command -v pip3 &> /dev/null; then
    pip3 install selenium
    echo "✅ Selenium installed"
elif command -v pip &> /dev/null; then
    pip install selenium
    echo "✅ Selenium installed"
else
    echo "⚠️ pip not found, install manually: pip3 install selenium"
fi

# Test installation
echo "🧪 Testing ChromeDriver installation..."

if command -v chromedriver &> /dev/null; then
    CHROMEDRIVER_VERSION=$(chromedriver --version)
    echo "✅ ChromeDriver: $CHROMEDRIVER_VERSION"
elif command -v /usr/local/bin/chromedriver &> /dev/null; then
    CHROMEDRIVER_VERSION=$(/usr/local/bin/chromedriver --version)
    echo "✅ ChromeDriver: $CHROMEDRIVER_VERSION"
else
    echo "❌ ChromeDriver not found in PATH"
    exit 1
fi

# Test Python Selenium
echo "🧪 Testing Python Selenium..."
python3 -c "
try:
    from selenium import webdriver
    from selenium.webdriver.chrome.options import Options
    print('✅ Selenium import successful')
    
    # Test headless Chrome
    options = Options()
    options.add_argument('--headless')
    options.add_argument('--no-sandbox')
    options.add_argument('--disable-dev-shm-usage')
    
    driver = webdriver.Chrome(options=options)
    driver.get('https://www.google.com')
    print('✅ Headless Chrome test successful')
    driver.quit()
    
except Exception as e:
    print(f'❌ Selenium test failed: {e}')
    exit(1)
"

if [ $? -eq 0 ]; then
    echo ""
    echo "🎉 ChromeDriver installation complete!"
    echo ""
    echo "Now you can use:"
    echo "  ./bin/setup-youtube-cookies-cli"
    echo "  (Choose option 2 for headless browser method)"
else
    echo "❌ Installation verification failed"
    exit 1
fi