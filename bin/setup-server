#!/bin/bash

# setup-server - Initial Server Setup for Social Link Telegram Bot
# ===============================================================
#
# This script performs the initial setup of the server environment
#
# Usage: ./bin/setup-server

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to run remote commands
run_remote() {
    local cmd="$1"
    local description="$2"
    
    log_info "$description"
    
    if ssh "${SERVER_USER}@${SERVER_IP}" "$cmd"; then
        log_success "$description completed"
        return 0
    else
        log_error "$description failed"
        return 1
    fi
}

# Main setup function
main() {
    echo "🔧 Initial Server Setup for Social Link Telegram Bot"
    echo "===================================================="
    echo ""
    
    # Test SSH connection
    log_info "Testing SSH connection..."
    if ! ssh -o ConnectTimeout=10 "${SERVER_USER}@${SERVER_IP}" "echo 'SSH connection successful'"; then
        log_error "Cannot connect to server via SSH"
        exit 1
    fi
    log_success "SSH connection verified"
    echo ""
    
    # Update system packages
    run_remote "sudo apt update && sudo apt upgrade -y" "Updating system packages"
    
    # Install essential packages
    run_remote "sudo apt install -y curl wget git build-essential python3 python3-pip systemctl" "Installing essential packages"
    
    # Install yt-dlp
    run_remote "pip3 install yt-dlp" "Installing yt-dlp"
    
    # Add pip local bin to PATH for the user
    run_remote "echo 'export PATH=\$HOME/.local/bin:\$PATH' >> ~/.bashrc && source ~/.bashrc" "Adding pip bin to PATH"
    
    # Create application directory
    run_remote "sudo mkdir -p /opt/social-link-bot" "Creating application directory"
    run_remote "sudo chown -R ${SERVER_USER}:${SERVER_USER} /opt/social-link-bot" "Setting directory ownership"
    
    # Create logs directory
    run_remote "mkdir -p /opt/social-link-bot/logs" "Creating logs directory"
    
    # Set up firewall (if ufw is available)
    run_remote "sudo ufw status || echo 'UFW not available'" "Checking firewall status"
    
    # Display server information
    echo ""
    log_info "Server information:"
    ssh "${SERVER_USER}@${SERVER_IP}" "
        echo 'OS: ' \$(lsb_release -d -s 2>/dev/null || cat /etc/os-release | grep PRETTY_NAME | cut -d'\"' -f2)
        echo 'Kernel: ' \$(uname -r)
        echo 'Memory: ' \$(free -h | awk '/^Mem:/ {print \$2}')
        echo 'Disk: ' \$(df -h / | awk 'NR==2 {print \$2 \" total, \" \$4 \" available\"}')
        echo 'Python: ' \$(python3 --version)
        echo 'yt-dlp: ' \$(yt-dlp --version 2>/dev/null || echo 'Not installed')
    "
    
    echo ""
    log_success "Server setup completed successfully!"
    echo ""
    
    log_info "Next steps:"
    echo "1. Configure your bot token: ./bin/server config"
    echo "2. Deploy your bot: ./bin/deploy"
    echo "3. Monitor logs: ./bin/server monitor"
    echo ""
    
    log_warning "Remember to:"
    echo "• Set up your Telegram bot token in the .env file"
    echo "• Test the deployment with: ./bin/deploy --dry-run"
    echo "• Monitor the bot logs after deployment"
}

# Run main function
main "$@"