#!/bin/bash

# deploy-production - Deploy to /var/www/social-link-tg-bot
# =========================================================
#
# This script builds locally and provides instructions for deployment
# to /var/www/social-link-tg-bot since it requires sudo
#
# Usage: ./bin/deploy-production

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"
REMOTE_PATH="/var/www/social-link-tg-bot"
BINARY_NAME="social-link-bot"
LOCAL_BINARY="./social-link-bot"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "🚀 Production Deployment for /var/www/social-link-tg-bot"
echo "========================================================"
echo ""

# Add Go to PATH if needed
if ! command -v go &> /dev/null && [ -x "$HOME/go/bin/go" ]; then
    export PATH="$HOME/go/bin:$PATH"
    export GOPATH="$HOME/go"
    echo -e "${BLUE}[INFO]${NC} Added Go to PATH from $HOME/go/bin"
fi

# Build
echo -e "${BLUE}[INFO]${NC} Building application..."
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o $BINARY_NAME .

if [ ! -f "$BINARY_NAME" ]; then
    echo -e "${RED}[ERROR]${NC} Build failed - binary not created"
    exit 1
fi

echo -e "${GREEN}[SUCCESS]${NC} Build completed"

# Get binary size
BINARY_SIZE=$(ls -lh $BINARY_NAME | awk '{print $5}')
echo -e "${BLUE}[INFO]${NC} Binary size: $BINARY_SIZE"

# Upload to home directory
echo -e "${BLUE}[INFO]${NC} Uploading binary to server..."
scp $BINARY_NAME ${SERVER_USER}@${SERVER_IP}:~/social-link-bot-new

echo -e "${GREEN}[SUCCESS]${NC} Binary uploaded to server"
echo ""

# Clean up local binary
rm -f $BINARY_NAME

# Generate deployment commands
echo -e "${YELLOW}[MANUAL STEPS REQUIRED]${NC}"
echo "========================"
echo ""
echo "The binary has been uploaded to your home directory on the server."
echo "To complete the deployment, SSH to the server and run:"
echo ""
echo -e "${BLUE}ssh ${SERVER_USER}@${SERVER_IP}${NC}"
echo ""
echo "Then run these commands:"
echo ""
echo -e "${GREEN}# 1. Stop the current bot${NC}"
echo "sudo systemctl stop social-link-bot"
echo ""
echo -e "${GREEN}# 2. Backup the current binary (optional)${NC}"
echo "sudo cp ${REMOTE_PATH}/${BINARY_NAME} ${REMOTE_PATH}/${BINARY_NAME}.backup"
echo ""
echo -e "${GREEN}# 3. Copy the new binary${NC}"
echo "sudo cp ~/${BINARY_NAME}-new ${REMOTE_PATH}/${BINARY_NAME}"
echo ""
echo -e "${GREEN}# 4. Set correct permissions${NC}"
echo "sudo chown tgbot:tgbot ${REMOTE_PATH}/${BINARY_NAME}"
echo "sudo chmod +x ${REMOTE_PATH}/${BINARY_NAME}"
echo ""
echo -e "${GREEN}# 5. Start the bot${NC}"
echo "sudo systemctl start social-link-bot"
echo ""
echo -e "${GREEN}# 6. Check status${NC}"
echo "sudo systemctl status social-link-bot"
echo ""
echo -e "${GREEN}# 7. Clean up${NC}"
echo "rm ~/${BINARY_NAME}-new"
echo ""
echo "================================"
echo ""
echo -e "${BLUE}[TIP]${NC} You can copy all commands at once:"
echo ""
cat << 'EOF'
sudo systemctl stop social-link-bot && \
sudo cp /var/www/social-link-tg-bot/social-link-bot /var/www/social-link-tg-bot/social-link-bot.backup && \
sudo cp ~/social-link-bot-new /var/www/social-link-tg-bot/social-link-bot && \
sudo chown tgbot:tgbot /var/www/social-link-tg-bot/social-link-bot && \
sudo chmod +x /var/www/social-link-tg-bot/social-link-bot && \
sudo systemctl start social-link-bot && \
sudo systemctl status social-link-bot && \
rm ~/social-link-bot-new
EOF