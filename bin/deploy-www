#!/bin/bash

# deploy-www - Deployment Script for /var/www/social-link-tg-bot
# ===========================================================
#
# This script deploys to the existing /var/www/social-link-tg-bot location
#
# Usage: ./bin/deploy-www

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"
REMOTE_PATH="/var/www/social-link-tg-bot"
BINARY_NAME="social-link-bot"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "🚀 Deploying to /var/www/social-link-tg-bot"
echo "=========================================="

# Add Go to PATH if needed
if ! command -v go &> /dev/null && [ -x "$HOME/go/bin/go" ]; then
    export PATH="$HOME/go/bin:$PATH"
    export GOPATH="$HOME/go"
fi

# Build
echo -e "${BLUE}[INFO]${NC} Building application..."
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o $BINARY_NAME .

# Upload to temp location first
echo -e "${BLUE}[INFO]${NC} Uploading binary..."
TEMP_FILE="${BINARY_NAME}.new"
scp $BINARY_NAME ${SERVER_USER}@${SERVER_IP}:/tmp/${TEMP_FILE}

# Stop the service, replace binary, and restart
echo -e "${BLUE}[INFO]${NC} Updating binary and restarting service..."
ssh ${SERVER_USER}@${SERVER_IP} "
    # Try to stop the service (may need sudo)
    sudo systemctl stop social-link-bot 2>/dev/null || echo 'Could not stop service with systemctl'
    
    # Kill the process if still running
    sudo pkill -f '/var/www/social-link-tg-bot/social-link-bot' 2>/dev/null || echo 'No process to kill'
    
    # Wait a moment
    sleep 2
    
    # Move the new binary
    sudo mv /tmp/${TEMP_FILE} ${REMOTE_PATH}/${BINARY_NAME}
    sudo chmod +x ${REMOTE_PATH}/${BINARY_NAME}
    sudo chown tgbot:tgbot ${REMOTE_PATH}/${BINARY_NAME}
    
    # Start the service
    sudo systemctl start social-link-bot 2>/dev/null || echo 'Could not start service with systemctl'
"

echo -e "${GREEN}[SUCCESS]${NC} Deployment completed!"
echo ""
echo "Check status with:"
echo "  ssh ${SERVER_USER}@${SERVER_IP} 'sudo systemctl status social-link-bot'"