#!/bin/bash

# CLI-only YouTube cookie extraction using curl
# This method works without GUI browsers

echo "🌐 CLI YouTube Cookie Extraction"
echo "================================"
echo ""

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="$(dirname "$SCRIPT_DIR")"

echo "This method extracts basic cookies using curl, but has limitations:"
echo "❌ Cannot handle JavaScript/CAPTCHA"
echo "❌ Cannot perform interactive login"
echo "✅ Can extract public session cookies"
echo "✅ Works for basic unauthenticated access"
echo ""

read -p "Continue with basic cookie extraction? (y/n): " continue_curl

if [ "$continue_curl" != "y" ] && [ "$continue_curl" != "Y" ]; then
    echo "Use ./bin/quick-youtube-cookies for manual method instead"
    exit 0
fi

echo ""
echo "🔄 Extracting basic YouTube cookies..."

# Create cookie jar file
COOKIE_JAR="$BOT_DIR/youtube_cookies_curl.txt"

# Make initial request to YouTube to get basic cookies
curl -s -c "$COOKIE_JAR" \
     -H "User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" \
     -H "Accept: text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8" \
     -H "Accept-Language: en-US,en;q=0.5" \
     -H "Accept-Encoding: gzip, deflate" \
     -H "Connection: keep-alive" \
     "https://www.youtube.com/" > /dev/null

if [ -f "$COOKIE_JAR" ] && [ -s "$COOKIE_JAR" ]; then
    echo "✅ Basic cookies extracted"
    
    # Convert curl format to Netscape format if needed
    if ! head -1 "$COOKIE_JAR" | grep -q "Netscape HTTP Cookie File"; then
        echo "🔄 Converting to Netscape format..."
        
        # Create proper Netscape header
        cat > "$BOT_DIR/youtube_cookies.txt" << EOF
# Netscape HTTP Cookie File
# This file is generated by curl for yt-dlp compatibility
EOF
        
        # Convert and append cookies (skip comment lines)
        grep -v '^#' "$COOKIE_JAR" | while IFS=$'\t' read -r domain flag path secure expiration name value; do
            if [ -n "$domain" ] && [ -n "$name" ]; then
                echo -e "$domain\t$flag\t$path\t$secure\t$expiration\t$name\t$value" >> "$BOT_DIR/youtube_cookies.txt"
            fi
        done
        
        rm "$COOKIE_JAR"
    else
        mv "$COOKIE_JAR" "$BOT_DIR/youtube_cookies.txt"
    fi
    
    echo "📁 Cookie file: $BOT_DIR/youtube_cookies.txt"
    
    # Test the cookies
    echo "🧪 Testing basic cookies..."
    if yt-dlp --cookies "$BOT_DIR/youtube_cookies.txt" --dump-json --no-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ" >/dev/null 2>&1; then
        echo "✅ Basic cookies working for public videos!"
        echo ""
        echo "⚠️  Limitations:"
        echo "   - Only works for public videos"
        echo "   - No authentication/login cookies"
        echo "   - May not bypass all restrictions"
        echo ""
        echo "💡 For full access, use: ./bin/quick-youtube-cookies"
    else
        echo "⚠️  Basic cookies have limited functionality"
        echo ""
        echo "This is normal for curl-extracted cookies."
        echo "For authenticated access, use: ./bin/quick-youtube-cookies"
    fi
    
else
    echo "❌ Failed to extract cookies"
    echo ""
    echo "🔄 Trying alternative method..."
    
    # Alternative: Create minimal cookie file
    cat > "$BOT_DIR/youtube_cookies.txt" << 'EOF'
# Netscape HTTP Cookie File
# Minimal YouTube cookies for basic access

.youtube.com	TRUE	/	FALSE	0	VISITOR_INFO1_LIVE	PLACEHOLDER_ID
.youtube.com	TRUE	/	FALSE	0	PREF	f6=40000000&tz=UTC&hl=en
youtube.com	FALSE	/	FALSE	0	YSC	PLACEHOLDER_ID
EOF
    
    echo "✅ Created minimal cookie file for basic access"
    echo "⚠️  Very limited functionality - use manual method for better results"
fi

echo ""
echo "📋 For authenticated access, run:"
echo "   ./bin/quick-youtube-cookies"