#!/bin/bash

# configure-token - Configure Telegram Bot Token
# ==============================================
#
# This script helps you configure the bot token on the server
#
# Usage: ./bin/configure-token YOUR_BOT_TOKEN

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"
REMOTE_PATH="/path/to/social-link-bot"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Main function
main() {
    echo "🔑 Configure Telegram Bot Token"
    echo "==============================="
    echo ""
    
    if [ $# -eq 0 ]; then
        log_error "No token provided"
        echo ""
        echo "Usage: $0 YOUR_BOT_TOKEN"
        echo ""
        echo "Get your bot token from @BotFather on Telegram:"
        echo "1. Message @BotFather"
        echo "2. Send /newbot or /mybots"
        echo "3. Copy the token (looks like: 123456789:ABCdefGhIJKlmNOP-qrstuvwxyz)"
        echo ""
        exit 1
    fi
    
    TOKEN="$1"
    
    # Validate token format (basic check)
    if [[ ! "$TOKEN" =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
        log_error "Invalid token format"
        echo "Token should look like: 123456789:ABCdefGhIJKlmNOP-qrstuvwxyz"
        exit 1
    fi
    
    log_info "Configuring bot token on server..."
    
    # Update the token
    if ssh "${SERVER_USER}@${SERVER_IP}" "sed -i 's/TG_BOT_TOKEN=\".*\"/TG_BOT_TOKEN=\"${TOKEN}\"/' ${REMOTE_PATH}/.env"; then
        log_success "Bot token configured successfully"
    else
        log_error "Failed to configure bot token"
        exit 1
    fi
    
    # Restart the service
    log_info "Restarting bot service..."
    if ssh "${SERVER_USER}@${SERVER_IP}" "systemctl --user restart social-link-bot"; then
        log_success "Bot service restarted"
    else
        log_error "Failed to restart service"
        exit 1
    fi
    
    # Wait a moment
    sleep 3
    
    # Check status
    log_info "Checking bot status..."
    if ssh "${SERVER_USER}@${SERVER_IP}" "systemctl --user is-active social-link-bot | grep -q active"; then
        log_success "Bot is running!"
        echo ""
        echo "✅ Your bot is now active and ready to use!"
        echo ""
        echo "Next steps:"
        echo "1. Open Telegram and search for your bot"
        echo "2. Send a message with Instagram, TikTok, or Twitter links"
        echo "3. The bot will download and send the media back to you"
        echo ""
        echo "Monitor logs with: ./bin/server monitor"
    else
        log_error "Bot is not active"
        echo ""
        echo "Check logs with: ./bin/server logs"
        echo "Check status with: ./bin/server status"
    fi
}

# Run main function with all arguments
main "$@"