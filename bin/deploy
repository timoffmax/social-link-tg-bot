#!/bin/bash

# deploy - Deployment Script for Social Link Telegram Bot
# ====================================================
#
# This script deploys the social link Telegram bot to the production server
#
# Usage: 
#   ./bin/deploy [--dry-run] [--skip-build] [--restart-only]
#
# Options:
#   --dry-run       Show what would be done without executing
#   --skip-build    Skip the build step (use existing binary)
#   --restart-only  Only restart the service, don't update code

set -euo pipefail

# Configuration
SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"
REMOTE_PATH="/path/to/social-link-bot"
SERVICE_NAME="social-link-bot"
BINARY_NAME="social-link-bot"
LOCAL_BINARY="./social-link-bot"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Parse command line arguments
DRY_RUN=false
SKIP_BUILD=false
RESTART_ONLY=false

while [[ $# -gt 0 ]]; do
    case $1 in
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --skip-build)
            SKIP_BUILD=true
            shift
            ;;
        --restart-only)
            RESTART_ONLY=true
            shift
            ;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [--dry-run] [--skip-build] [--restart-only]"
            exit 1
            ;;
    esac
done

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Function to run commands (with dry-run support)
run_command() {
    local cmd="$1"
    local description="$2"
    
    log_info "$description"
    
    if [ "$DRY_RUN" = true ]; then
        echo "  [DRY-RUN] Would run: $cmd"
        return 0
    fi
    
    if eval "$cmd"; then
        log_success "$description completed"
        return 0
    else
        log_error "$description failed"
        return 1
    fi
}

# Function to run remote commands
run_remote() {
    local cmd="$1"
    local description="$2"
    
    log_info "$description"
    
    if [ "$DRY_RUN" = true ]; then
        echo "  [DRY-RUN] Would run on server: $cmd"
        return 0
    fi
    
    if ssh "${SERVER_USER}@${SERVER_IP}" "$cmd"; then
        log_success "$description completed"
        return 0
    else
        log_error "$description failed"
        return 1
    fi
}

# Function to check prerequisites
check_prerequisites() {
    log_info "Checking prerequisites..."
    
    # Check if we're in the right directory
    if [[ ! -f "go.mod" ]] || [[ ! -f "main.go" ]]; then
        log_error "Not in the project root directory"
        exit 1
    fi
    
    # Check if Go is available (unless skipping build)
    if [ "$SKIP_BUILD" = false ] && [ "$RESTART_ONLY" = false ]; then
        # Try to find Go and add it to PATH
        if ! command -v go &> /dev/null; then
            if [ -x "$HOME/go/bin/go" ]; then
                export PATH="$HOME/go/bin:$PATH"
                export GOPATH="$HOME/go"
                log_info "Added Go to PATH from $HOME/go/bin"
            else
                log_error "Go is not installed or not in PATH. Please install Go or run: export PATH=\$HOME/go/bin:\$PATH"
                exit 1
            fi
        fi
    fi
    
    # Check SSH connectivity
    if [ "$DRY_RUN" = false ]; then
        log_info "Testing SSH connection..."
        if ! ssh -o ConnectTimeout=10 "${SERVER_USER}@${SERVER_IP}" "echo 'SSH connection successful'"; then
            log_error "Cannot connect to server via SSH"
            exit 1
        fi
        log_success "SSH connection verified"
    fi
}

# Function to build the application
build_application() {
    if [ "$SKIP_BUILD" = true ] || [ "$RESTART_ONLY" = true ]; then
        log_info "Skipping build step"
        return 0
    fi
    
    log_info "Building application for Linux..."
    
    # Clean previous build
    run_command "rm -f $BINARY_NAME" "Cleaning previous build"
    
    # Build for Linux with CGO disabled for better compatibility
    run_command "CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o $BINARY_NAME ." "Building application"
    
    # Verify binary was created
    if [ "$DRY_RUN" = false ] && [ ! -f "$BINARY_NAME" ]; then
        log_error "Binary was not created"
        exit 1
    fi
    
    log_success "Application built successfully"
}

# Function to prepare server environment
prepare_server() {
    if [ "$RESTART_ONLY" = true ]; then
        log_info "Skipping server preparation"
        return 0
    fi
    
    log_info "Preparing server environment..."
    
    # Create application directory (in user home, no sudo needed)
    run_remote "mkdir -p $REMOTE_PATH" "Creating application directory"
    
    # Install yt-dlp if not present (user-level installation)
    run_remote "which yt-dlp || pip3 install --user yt-dlp" "Installing yt-dlp dependency"
    
    # Create logs directory
    run_remote "mkdir -p $REMOTE_PATH/logs" "Creating logs directory"
}

# Function to stop the service
stop_service() {
    log_info "Stopping service if running..."
    
    # Stop user systemd service if it exists
    run_remote "systemctl --user is-active --quiet $SERVICE_NAME && systemctl --user stop $SERVICE_NAME || echo 'Service not running or does not exist'" "Stopping user systemd service"
    
    # Kill any running processes as fallback - skipped for now
    log_info "Skipping process cleanup for initial deployment"
    
    # Wait a moment for graceful shutdown
    if [ "$DRY_RUN" = false ]; then
        sleep 2
    fi
}

# Function to deploy files
deploy_files() {
    if [ "$RESTART_ONLY" = true ]; then
        log_info "Skipping file deployment"
        return 0
    fi
    
    log_info "Deploying files to server..."
    
    # Upload binary
    run_command "scp $LOCAL_BINARY ${SERVER_USER}@${SERVER_IP}:${REMOTE_PATH}/" "Uploading binary"
    
    # Upload .env.dist as template
    run_command "scp .env.dist ${SERVER_USER}@${SERVER_IP}:${REMOTE_PATH}/" "Uploading environment template"
    
    # Set executable permissions
    run_remote "chmod +x ${REMOTE_PATH}/${BINARY_NAME}" "Setting executable permissions"
    
    # Create .env file if it doesn't exist
    run_remote "test -f ${REMOTE_PATH}/.env || cp ${REMOTE_PATH}/.env.dist ${REMOTE_PATH}/.env" "Creating .env file if needed"
}

# Function to create systemd service
create_systemd_service() {
    if [ "$RESTART_ONLY" = true ]; then
        log_info "Skipping systemd service creation"
        return 0
    fi
    
    log_info "Creating systemd service..."
    
    # Create service file content
    local service_content="[Unit]
Description=Social Link Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=$REMOTE_PATH
ExecStart=${REMOTE_PATH}/${BINARY_NAME}
Restart=always
RestartSec=10
StandardOutput=append:${REMOTE_PATH}/logs/bot.log
StandardError=append:${REMOTE_PATH}/logs/bot.log
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/${SERVER_USER}/.local/bin

[Install]
WantedBy=default.target"
    
    # Create user systemd directory
    run_remote "mkdir -p ~/.config/systemd/user" "Creating user systemd directory"
    
    # Upload service file to user systemd
    if [ "$DRY_RUN" = false ]; then
        echo "$service_content" | ssh "${SERVER_USER}@${SERVER_IP}" "tee ~/.config/systemd/user/${SERVICE_NAME}.service > /dev/null"
        log_success "User systemd service file created"
    else
        echo "  [DRY-RUN] Would create user systemd service file"
    fi
    
    # Reload user systemd and enable service
    run_remote "systemctl --user daemon-reload" "Reloading user systemd"
    run_remote "systemctl --user enable $SERVICE_NAME" "Enabling user service"
}

# Function to start the service
start_service() {
    log_info "Starting service..."
    
    # Start the user service
    run_remote "systemctl --user start $SERVICE_NAME" "Starting user systemd service"
    
    # Wait a moment for startup
    if [ "$DRY_RUN" = false ]; then
        sleep 3
    fi
    
    # Check service status
    if run_remote "systemctl --user is-active $SERVICE_NAME" "Checking service status"; then
        log_success "Service started successfully"
    else
        log_warning "Service is not active yet - this is normal if the bot token is not configured"
        log_info "Configure your bot token and restart the service"
    fi
}

# Function to show service status and logs
show_status() {
    if [ "$DRY_RUN" = true ]; then
        log_info "Would show service status and recent logs"
        return 0
    fi
    
    log_info "Service status:"
    ssh "${SERVER_USER}@${SERVER_IP}" "systemctl --user status $SERVICE_NAME --no-pager -l" || true
    
    echo ""
    log_info "Recent logs:"
    ssh "${SERVER_USER}@${SERVER_IP}" "tail -20 ${REMOTE_PATH}/logs/bot.log" || true
}

# Function to show useful commands
show_helpful_commands() {
    log_info "Helpful commands for managing the bot:"
    echo ""
    echo "  View logs:"
    echo "    ssh ${SERVER_USER}@${SERVER_IP} 'tail -f ${REMOTE_PATH}/logs/bot.log'"
    echo ""
    echo "  Service management:"
    echo "    ssh ${SERVER_USER}@${SERVER_IP} 'systemctl --user status ${SERVICE_NAME}'"
    echo "    ssh ${SERVER_USER}@${SERVER_IP} 'systemctl --user restart ${SERVICE_NAME}'"
    echo "    ssh ${SERVER_USER}@${SERVER_IP} 'systemctl --user stop ${SERVICE_NAME}'"
    echo ""
    echo "  Configuration:"
    echo "    ssh ${SERVER_USER}@${SERVER_IP} 'nano ${REMOTE_PATH}/.env'"
    echo ""
}

# Main deployment function
main() {
    echo "🚀 Social Link Telegram Bot Deployment"
    echo "======================================"
    echo ""
    
    if [ "$DRY_RUN" = true ]; then
        log_warning "DRY RUN MODE - No changes will be made"
        echo ""
    fi
    
    # Check prerequisites
    check_prerequisites
    
    # Build application
    build_application
    
    # Prepare server
    prepare_server
    
    # Stop existing service
    stop_service
    
    # Deploy files
    deploy_files
    
    # Create systemd service
    create_systemd_service
    
    # Start service
    start_service
    
    echo ""
    log_success "Deployment completed successfully!"
    echo ""
    
    # Show status and helpful commands
    show_status
    show_helpful_commands
    
    if [ "$DRY_RUN" = false ]; then
        echo ""
        log_warning "Don't forget to configure your .env file on the server with your Telegram bot token!"
        echo "  ssh ${SERVER_USER}@${SERVER_IP} 'nano ${REMOTE_PATH}/.env'"
    fi
}

# Run main function
main "$@"