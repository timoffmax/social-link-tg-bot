#!/bin/bash

# Simple deployment script for Social Link Telegram Bot
# ====================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CONFIG_FILE="$SCRIPT_DIR/deploy.conf"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Load config
if [ ! -f "$CONFIG_FILE" ]; then
    log_error "Config file not found: $CONFIG_FILE"
    exit 1
fi
source "$CONFIG_FILE"

# Parse options
RESTART_ONLY=false
if [[ "${1:-}" == "--restart-only" ]]; then
    RESTART_ONLY=true
fi

echo "🚀 Deploying Social Link Bot"
echo "============================"

if [ "$RESTART_ONLY" = false ]; then
    # Build locally
    log_info "Building application..."
    cd "$PROJECT_DIR"
    export GOOS=linux GOARCH=amd64
    go build -o social-link-bot .
    log_success "Build completed"

    # Copy binary to server
    log_info "Copying binary to server..."
    scp -i "$SERVER_SSH_KEY" social-link-bot "$SERVER_USER@$SERVER_IP:$REMOTE_DIR/"
    log_success "Binary uploaded"
fi

# Restart service
log_info "Restarting service..."
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo systemctl restart $SERVICE_NAME"
sleep 2

# Check status
log_info "Checking service status..."
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "sudo systemctl status $SERVICE_NAME --no-pager" || true

# Show recent logs
log_info "Recent logs:"
ssh -i "$SERVER_SSH_KEY" "$SERVER_USER@$SERVER_IP" "tail -n 10 $REMOTE_DIR/logs/bot.log 2>/dev/null || echo 'No logs yet'"

log_success "Deployment completed!"

echo ""
echo "📋 Useful commands:"
echo "  View logs: ssh -i $SERVER_SSH_KEY $SERVER_USER@$SERVER_IP 'tail -f $REMOTE_DIR/logs/bot.log'"
echo "  Restart:   $0 --restart-only"