#!/bin/bash

# deploy-simple - Simple deployment without sudo
# =============================================

set -euo pipefail

SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"

echo "🚀 Simple Deployment (uploads binary only)"
echo "========================================="

# Add Go to PATH if needed
if ! command -v go &> /dev/null && [ -x "$HOME/go/bin/go" ]; then
    export PATH="$HOME/go/bin:$PATH"
fi

# Build
echo "Building application..."
CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o social-link-bot .

# Upload to your home directory
echo "Uploading binary to home directory..."
scp social-link-bot ${SERVER_USER}@${SERVER_IP}:~/

echo ""
echo "✅ Binary uploaded to ~/social-link-bot"
echo ""
echo "To replace the running bot at /var/www/social-link-tg-bot:"
echo "1. SSH to server: ssh ${SERVER_USER}@${SERVER_IP}"
echo "2. Stop the bot: sudo systemctl stop social-link-bot"
echo "3. Copy binary: sudo cp ~/social-link-bot /var/www/social-link-tg-bot/"
echo "4. Set permissions: sudo chown tgbot:tgbot /var/www/social-link-tg-bot/social-link-bot"
echo "5. Start the bot: sudo systemctl start social-link-bot"
echo ""
echo "Or use the deployment at /path/to/social-link-bot with a different token"