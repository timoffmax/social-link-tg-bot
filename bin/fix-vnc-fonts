#!/bin/bash

# Fix VNC font issues on Ubuntu/Debian servers
# Solves "could not open default font 'fixed'" error

echo "🔧 Fixing VNC Font Issues"
echo "========================="
echo ""

echo "The VNC server failed because X11 fonts are missing."
echo "This script will install the required fonts."
echo ""

# Check if we can use sudo
if sudo -n true 2>/dev/null; then
    echo "📦 Installing X11 fonts with sudo..."
    sudo apt update
    sudo apt install -y xfonts-base xfonts-75dpi xfonts-100dpi fonts-dejavu-core
    
    # Also install additional desktop fonts
    sudo apt install -y fonts-liberation fonts-dejavu fonts-droid-fallback
    
    echo "✅ Fonts installed successfully!"
else
    echo "❌ Cannot use sudo without password prompt."
    echo ""
    echo "Please run these commands manually:"
    echo ""
    echo "sudo apt update"
    echo "sudo apt install -y xfonts-base xfonts-75dpi xfonts-100dpi fonts-dejavu-core"
    echo "sudo apt install -y fonts-liberation fonts-dejavu fonts-droid-fallback"
    echo ""
    echo "Then run this script again."
    exit 1
fi

# Kill any existing VNC sessions
echo "🧹 Cleaning up existing VNC sessions..."
vncserver -kill :1 2>/dev/null || true

# Remove any corrupted X11 lock files
rm -f /tmp/.X1-lock /tmp/.X11-unix/X1 2>/dev/null || true

# Create a better xstartup script
echo "🔧 Creating improved VNC startup script..."
mkdir -p ~/.vnc

cat > ~/.vnc/xstartup << 'EOF'
#!/bin/bash

# Set background
xsetroot -solid grey

# Load X resources
[ -x /etc/vnc/xstartup ] && exec /etc/vnc/xstartup
[ -r $HOME/.Xresources ] && xrdb $HOME/.Xresources

# Start window manager and applications
xfce4-panel &
xfce4-terminal &
sleep 2
firefox &
xfwm4 &

# Keep the session alive
exec /usr/bin/xfce4-session
EOF

chmod +x ~/.vnc/xstartup

echo "🚀 Starting VNC server with proper configuration..."

# Start VNC with explicit font path
vncserver :1 -geometry 1280x800 -depth 24 -dpi 96

# Check if it started successfully
if pgrep -f "Xtightvnc.*:1" > /dev/null; then
    echo ""
    echo "✅ VNC Server started successfully!"
    echo ""
    echo "🌐 Connection info:"
    echo "   Server IP: $(curl -s ifconfig.me 2>/dev/null || hostname -I | awk '{print $1}')"
    echo "   VNC Port: 5901"
    echo "   Display: :1"
    echo ""
    echo "📱 Connect using:"
    echo "   SSH Tunnel: ssh -L 5901:localhost:5901 botuser@$(curl -s ifconfig.me 2>/dev/null)"
    echo "   Then VNC to: localhost:5901"
    echo ""
    echo "🔄 VNC Management:"
    echo "   Stop: vncserver -kill :1"
    echo "   Restart: vncserver -kill :1 && vncserver :1"
    echo "   Logs: cat ~/.vnc/*.log"
else
    echo ""
    echo "❌ VNC server still failed to start"
    echo ""
    echo "🔍 Check logs:"
    echo "cat ~/.vnc/*.log"
    echo ""
    echo "🔧 Manual troubleshooting:"
    echo "1. Check font installation: fc-list | head"
    echo "2. Test X11: DISPLAY=:1 xeyes &"
    echo "3. Try different geometry: vncserver :1 -geometry 1024x768"
    echo ""
    echo "🆘 Alternative: Try X11 forwarding instead:"
    echo "   ssh -X botuser@server"
    echo "   firefox"
fi