#!/bin/bash

# restart-service - Restart the systemd service for Social Link Bot
# ================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/deploy.conf"

# Load configuration
if [ -f "$CONFIG_FILE" ]; then
    source "$CONFIG_FILE"
else
    echo "Error: Configuration file not found: $CONFIG_FILE"
    exit 1
fi

echo "🔄 Restarting systemd service for Social Link Bot..."
echo "Service: $SERVICE_NAME"
echo "Server: $SERVER_IP"
echo ""

# Instructions for manual restart
echo "Please run the following commands on the server:"
echo ""
echo "1. SSH into the server:"
echo "   ssh $SERVER_USER@$SERVER_IP"
echo ""
echo "2. Restart the service:"
echo "   sudo systemctl restart $SERVICE_NAME"
echo ""
echo "3. Check the status:"
echo "   sudo systemctl status $SERVICE_NAME"
echo ""
echo "4. Check logs:"
echo "   sudo journalctl -u $SERVICE_NAME -f"
echo ""

# Optional: Try to do it automatically (will fail without passwordless sudo)
read -p "Try automatic restart? (requires passwordless sudo) [y/N]: " -n 1 -r
echo
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo "Attempting automatic restart..."
    if ssh "$SERVER_USER@$SERVER_IP" "sudo systemctl restart $SERVICE_NAME" 2>/dev/null; then
        echo "✅ Service restarted successfully!"
        ssh "$SERVER_USER@$SERVER_IP" "sudo systemctl status $SERVICE_NAME --no-pager"
    else
        echo "❌ Automatic restart failed. Please run the manual commands above."
    fi
fi