#!/bin/bash

# production-status - Check production bot status
# ==============================================

set -euo pipefail

SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo "📊 Production Bot Status"
echo "======================="
echo ""

ssh ${SERVER_USER}@${SERVER_IP} '
    echo "🤖 Bot Process:"
    ps aux | grep -E "social-link.*bot" | grep -v grep || echo "No bot process found"
    
    echo ""
    echo "📁 Bot Location: /var/www/social-link-tg-bot"
    echo ""
    echo "📋 Binary Info:"
    ls -la /var/www/social-link-tg-bot/social-link-bot 2>/dev/null || echo "Binary not found"
    
    echo ""
    echo "🔧 Service Status:"
    sudo systemctl status social-link-bot --no-pager 2>/dev/null || echo "Cannot check service status (needs sudo)"
    
    echo ""
    echo "📝 Configuration:"
    grep "TG_BOT_TOKEN" /var/www/social-link-tg-bot/.env 2>/dev/null | sed "s/=.*/=***/" || echo "Cannot read config"
'