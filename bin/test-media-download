#!/bin/bash

# test-media-download - Test if bot downloads media from social links
# =================================================================

set -euo pipefail

SERVER_IP="YOUR_SERVER_IP"
SERVER_USER="YOUR_USER"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo "🧪 Testing Bot Media Download Functionality"
echo "=========================================="
echo ""

echo -e "${BLUE}[INFO]${NC} Monitoring bot logs for media download activity..."
echo ""
echo "To test the bot:"
echo "1. Send an Instagram, TikTok, or Twitter link to your bot in Telegram"
echo "2. Watch the logs below for yt-dlp activity"
echo ""
echo "Press Ctrl+C to stop monitoring"
echo ""

ssh ${SERVER_USER}@${SERVER_IP} 'tail -f /var/www/social-link-tg-bot/bot.log'