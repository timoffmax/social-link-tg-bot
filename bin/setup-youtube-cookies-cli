#!/bin/bash

# YouTube Cookie Setup for CLI/Server Environment
# Multiple methods for headless/CLI cookie extraction

echo "🖥️  YouTube Cookie Setup for CLI/Server Environment"
echo "=============================================="

# Get the script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BOT_DIR="$(dirname "$SCRIPT_DIR")"

echo "🔍 Bot directory: $BOT_DIR"
echo ""

# Method selection
echo "Choose your cookie extraction method:"
echo ""
echo "1. 📋 Manual cookie paste (easiest)"
echo "2. 🌐 Headless browser automation (requires installation)"
echo "3. 🔗 SSH tunnel + local browser (advanced)"
echo "4. 📁 Upload cookie file via SCP/SFTP"
echo "5. ❓ Help - explain each method"
echo ""

read -p "Select method (1-5): " method

case $method in
    1)
        echo ""
        echo "📋 Manual Cookie Paste Method"
        echo "=============================="
        echo ""
        echo "Steps:"
        echo "1. On your LOCAL computer with a browser:"
        echo "   - Open YouTube and log in"
        echo "   - Install 'Get cookies.txt LOCALLY' extension"
        echo "   - Export cookies to a file"
        echo "   - Open the file in a text editor"
        echo ""
        echo "2. Copy the ENTIRE content of the cookie file"
        echo "3. Paste it below when prompted"
        echo ""
        
        echo "Paste your YouTube cookies (Ctrl+D when done):"
        cat > "$BOT_DIR/youtube_cookies.txt"
        
        if [ -s "$BOT_DIR/youtube_cookies.txt" ]; then
            echo ""
            echo "✅ Cookie file created: $BOT_DIR/youtube_cookies.txt"
            echo "🧪 Testing cookies..."
            
            if yt-dlp --cookies "$BOT_DIR/youtube_cookies.txt" --dump-json --no-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ" >/dev/null 2>&1; then
                echo "✅ Cookies are working!"
            else
                echo "❌ Cookie test failed. Please check the format."
            fi
        else
            echo "❌ No cookie data received."
        fi
        ;;
        
    2)
        echo ""
        echo "🌐 Headless Browser Method"
        echo "========================="
        echo ""
        
        # Check if required tools are available
        missing_tools=()
        
        if ! command -v python3 &> /dev/null; then
            missing_tools+=("python3")
        fi
        
        if ! python3 -c "import selenium" 2>/dev/null; then
            missing_tools+=("selenium")
        fi
        
        if ! command -v google-chrome &> /dev/null && ! command -v chromium &> /dev/null; then
            missing_tools+=("chrome/chromium")
        fi
        
        if [ ${#missing_tools[@]} -gt 0 ]; then
            echo "❌ Missing required tools: ${missing_tools[*]}"
            echo ""
            echo "Installation commands:"
            echo "# Install Python packages"
            echo "pip3 install selenium"
            echo ""
            echo "# Install Chrome (Ubuntu/Debian)"
            echo "wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | sudo apt-key add -"
            echo "echo 'deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main' | sudo tee /etc/apt/sources.list.d/google-chrome.list"
            echo "sudo apt update && sudo apt install google-chrome-stable"
            echo ""
            echo "# Install ChromeDriver"
            echo "sudo apt install chromium-chromedriver"
            exit 1
        fi
        
        echo "🔧 Creating headless browser script..."
        cat > "$BOT_DIR/get_youtube_cookies.py" << 'EOF'
#!/usr/bin/env python3

import time
import json
from selenium import webdriver
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC

def get_youtube_cookies():
    print("🌐 Setting up headless browser...")
    
    # Chrome options for headless mode
    chrome_options = Options()
    chrome_options.add_argument("--headless")
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    chrome_options.add_argument("--disable-gpu")
    chrome_options.add_argument("--window-size=1920,1080")
    chrome_options.add_argument("--user-agent=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36")
    
    try:
        driver = webdriver.Chrome(options=chrome_options)
        
        print("📱 Opening YouTube...")
        driver.get("https://www.youtube.com")
        
        # Wait for page to load
        WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.TAG_NAME, "body"))
        )
        
        print("⚠️  MANUAL STEP REQUIRED:")
        print("   1. The browser is running in headless mode")
        print("   2. You need to manually log in to YouTube")
        print("   3. This requires X11 forwarding or VNC")
        print("")
        print("Alternative: Use method 1 (manual paste) or method 3 (SSH tunnel)")
        
        driver.quit()
        return False
        
    except Exception as e:
        print(f"❌ Browser automation failed: {e}")
        print("💡 Try method 1 (manual paste) instead")
        return False

if __name__ == "__main__":
    get_youtube_cookies()
EOF
        
        python3 "$BOT_DIR/get_youtube_cookies.py"
        ;;
        
    3)
        echo ""
        echo "🔗 SSH Tunnel + Local Browser Method"
        echo "===================================="
        echo ""
        echo "This method forwards your local browser to the server:"
        echo ""
        echo "1. On your LOCAL machine, run:"
        echo "   ssh -L 8080:localhost:8080 user@your-server"
        echo ""
        echo "2. On the SERVER (this machine), run:"
        echo "   python3 -m http.server 8080 --directory $BOT_DIR"
        echo ""
        echo "3. On your LOCAL machine:"
        echo "   - Open browser and go to http://localhost:8080"
        echo "   - You'll see the bot directory"
        echo "   - Manually create/upload youtube_cookies.txt"
        echo ""
        echo "4. Or use SCP to copy cookie file:"
        echo "   scp youtube_cookies.txt user@your-server:$BOT_DIR/"
        echo ""
        echo "Start HTTP server? (y/n): "
        read start_server
        
        if [ "$start_server" = "y" ] || [ "$start_server" = "Y" ]; then
            echo "🌐 Starting HTTP server on port 8080..."
            echo "📁 Serving directory: $BOT_DIR"
            echo "🔗 Local access: http://localhost:8080 (via SSH tunnel)"
            echo "Press Ctrl+C to stop"
            cd "$BOT_DIR"
            python3 -m http.server 8080
        fi
        ;;
        
    4)
        echo ""
        echo "📁 Upload Cookie File Method"
        echo "============================"
        echo ""
        echo "Use SCP or SFTP to upload your cookie file:"
        echo ""
        echo "From your LOCAL machine:"
        echo "  scp youtube_cookies.txt user@your-server:$BOT_DIR/"
        echo ""
        echo "Or with SFTP:"
        echo "  sftp user@your-server"
        echo "  put youtube_cookies.txt $BOT_DIR/"
        echo ""
        echo "Or using rsync:"
        echo "  rsync youtube_cookies.txt user@your-server:$BOT_DIR/"
        echo ""
        echo "Waiting for cookie file to be uploaded..."
        echo "Press Enter when upload is complete, or Ctrl+C to cancel"
        read
        
        if [ -f "$BOT_DIR/youtube_cookies.txt" ]; then
            echo "✅ Cookie file found!"
            echo "🧪 Testing cookies..."
            
            if yt-dlp --cookies "$BOT_DIR/youtube_cookies.txt" --dump-json --no-download "https://www.youtube.com/watch?v=dQw4w9WgXcQ" >/dev/null 2>&1; then
                echo "✅ Cookies are working!"
            else
                echo "❌ Cookie test failed. Please check the format."
            fi
        else
            echo "❌ Cookie file not found: $BOT_DIR/youtube_cookies.txt"
        fi
        ;;
        
    5)
        echo ""
        echo "❓ Method Explanations"
        echo "====================="
        echo ""
        echo "1. 📋 Manual Cookie Paste:"
        echo "   - Easiest method"
        echo "   - Export cookies on your local computer"
        echo "   - Copy/paste the content via terminal"
        echo "   - No additional tools required"
        echo ""
        echo "2. 🌐 Headless Browser:"
        echo "   - Requires Chrome + Selenium installation"
        echo "   - Difficult without GUI/X11"
        echo "   - Better for automated setups"
        echo "   - Needs display forwarding for login"
        echo ""
        echo "3. 🔗 SSH Tunnel:"
        echo "   - Forward local browser to server"
        echo "   - Use local browser capabilities"
        echo "   - Upload files through web interface"
        echo "   - Good for repeated access"
        echo ""
        echo "4. 📁 File Upload:"
        echo "   - Generate cookies locally"
        echo "   - Use SCP/SFTP/rsync to upload"
        echo "   - Simple and reliable"
        echo "   - Good for one-time setup"
        echo ""
        echo "Recommendation: Use method 1 (manual paste) for simplicity"
        ;;
        
    *)
        echo "❌ Invalid selection"
        exit 1
        ;;
esac

echo ""
echo "🎉 Cookie setup complete!"
echo "🤖 The bot will now use these cookies for YouTube downloads"